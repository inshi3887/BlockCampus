{
  "name": "@blockcampus/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file=../.env src/index.ts",
    "migrate": "tsx --env-file=../.env src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "test:storage": "tsx --test test/storage.integration.ts",
    "storage:init": "tsx --env-file=../.env src/init-storage.ts",
    "operator:create": "tsx --env-file=../.env src/create-operator.ts",
    "qa": "tsx test/qa-server.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "@aws-sdk/client-s3": "^3.900.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@electric-sql/pglite": "^0.3.14"
  }
}
