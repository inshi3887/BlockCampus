DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
IDENTITY_HASH_SECRET=replace-with-at-least-32-random-characters
ADMIN_ACCOUNTS=operator
# SeaweedFS mini: host 9000 -> S3 8333, host 9001 -> Admin UI 12535.
# Compose maps these S3 credentials to AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=campus
S3_SECRET_KEY=campus-local-secret
S3_BUCKET=campus
S3_PUBLIC_URL=http://127.0.0.1:9000/campus
# Separate credentials for the SeaweedFS Admin UI (development defaults only).
SEAWEED_ADMIN_USER=admin
SEAWEED_ADMIN_PASSWORD=campus-admin-local-secret
COOKIE_SECURE=false
# Comma-separated YYYY-MM-DD dates, supplied by operator after calendar review
HOLIDAYS=
