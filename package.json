{
  "name": "blockcampus",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm run test -w server",
    "migrate": "npm run migrate -w server",
    "test:storage": "npm run test:storage -w server",
    "sync:places": "node scripts/sync-places.mjs",
    "check:places": "node scripts/sync-places.mjs --check"
  }
}
